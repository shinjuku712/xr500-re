# Liectroux XR500 Local Network Configuration
# Obtained via `python3 scripts/scan_lan.py` and Tuya IoT Platform / `tinytuya wizard`

DEVICE_IP=192.168.1.100
DEVICE_ID=bf0123456789abcdef0123
LOCAL_KEY=0123456789abcdef
PROTOCOL_VERSION=3.3
DEVICE_PORT=6668

# Hardware Profile: 'T3' (default for newer boards) or 'T2' (legacy boards)
XR500_PROFILE=T3

# Set to true if running in dry-run/mock mode without physical vacuum connected
SIMULATION_MODE=false
